<Window x:Class="Udc.App.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Urban Dry Clean CRM - Setup"
        Height="720" Width="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}" Padding="24,16">
            <StackPanel Orientation="Horizontal">
                <Border Width="34" Height="34" CornerRadius="9" Background="#26FFFFFF" Margin="0,0,12,0">
                    <TextBlock Text="UDC" Foreground="White" FontWeight="Bold" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Urban Dry Clean CRM - Setup" Foreground="White" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="Connect this PC to your shop's database" Foreground="#D9E3F5" FontSize="12" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="TestButton" Content="Test connection" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="TestButton_Click" />
                <Button x:Name="SaveButton" Content="Save &amp; Continue" Style="{StaticResource PrimaryButton}" Click="SaveButton_Click" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20" MaxWidth="560" HorizontalAlignment="Left">

                <Border x:Name="StatusBanner" CornerRadius="8" Padding="12,10" Margin="0,0,0,14" Visibility="Collapsed">
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="13" />
                </Border>

                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Background="White" Padding="18,16" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="DATABASE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10" />
                        <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,14"
                                   Text="Same MySQL/MariaDB server the web app and Android app already use, so every PC and device shows the same live orders, payments and workshop status." />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Label Content="Host" />
                                <TextBox x:Name="DbHostBox" Text="127.0.0.1" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="Port" />
                                <TextBox x:Name="DbPortBox" Text="3306" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,0,0,10">
                            <Label Content="Database name" />
                            <TextBox x:Name="DbNameBox" />
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Label Content="User" />
                                <TextBox x:Name="DbUserBox" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="Password (optional)" />
                                <PasswordBox x:Name="DbPassBox" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Background="White" Padding="18,16" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="BUSINESS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10" />

                        <StackPanel Margin="0,0,0,10">
                            <Label Content="Business name" />
                            <TextBox x:Name="AppNameBox" Text="URBAN DRY CLEAN" />
                        </StackPanel>

                        <StackPanel Margin="0,0,0,6">
                            <Label Content="App secret key" />
                            <TextBox x:Name="AppSecretKeyBox" />
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,14">
                            If this PC talks to the <Run FontWeight="Bold">same database as your existing web app</Run>,
                            paste the <Run FontWeight="Bold">exact same</Run> secret key so WhatsApp tokens and other
                            encrypted settings stay readable. Setting up brand new? Leave blank - a random key is
                            generated for you.
                        </TextBlock>

                        <StackPanel Width="140" HorizontalAlignment="Left">
                            <Label Content="Local port" />
                            <TextBox x:Name="PortBox" Text="3100" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
