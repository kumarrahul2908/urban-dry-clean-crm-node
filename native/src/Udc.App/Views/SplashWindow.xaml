<Window x:Class="Udc.App.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Urban Dry Clean CRM"
        Height="300" Width="360"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="False"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource HeaderBrush}"
        ShowInTaskbar="True">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border Width="72" Height="72" CornerRadius="18" Background="#1FFFFFFF" Margin="0,0,0,18">
                <TextBlock Text="UDC" Foreground="White" FontWeight="Bold" FontSize="22"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Urban Dry Clean CRM" Foreground="White" FontSize="16" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,0,0,18" />
            <ProgressBar IsIndeterminate="True" Width="160" Height="4" Margin="0,0,0,14" />
            <TextBlock x:Name="StatusText" Text="Starting up..." Foreground="#D9E3F5" FontSize="12.5"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
