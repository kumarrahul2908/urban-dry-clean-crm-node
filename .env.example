# Same meaning as config/config.php in the PHP app
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_udc
DB_USER=u123456789_udcuser
DB_PASS=CHANGE_ME

APP_NAME=URBAN DRY CLEAN
APP_URL=https://test.urbandryclean.in
APP_TIMEZONE=Asia/Kolkata
# MUST be the SAME value as the PHP app's APP_SECRET_KEY so existing encrypted
# secrets (WhatsApp tokens etc.) stay decryptable during the migration.
APP_SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_STRING

SESSION_LIFETIME_MINUTES=120
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
API_TOKEN_LIFETIME_DAYS=30

# Set true only when behind a reverse proxy (nginx) so request.ip uses X-Forwarded-For
TRUST_PROXY=false
