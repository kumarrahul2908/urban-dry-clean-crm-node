{
  "name": "urban-dry-clean-crm-node",
  "version": "0.1.0",
  "private": true,
  "description": "Urban Dry Clean CRM - Node.js (TypeScript) port of the PHP app",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "job:photo-cleanup": "node dist/jobs/photoCleanup.js",
    "job:whatsapp-worker": "node dist/jobs/whatsappWorker.js",
    "job:whatsapp-marketing": "node dist/jobs/whatsappMarketing.js",
    "migrate": "node dist/jobs/migrate.js",
    "preflight": "node dist/jobs/preflight.js"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/formbody": "^7.4.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/multipart": "^8.3.1",
    "@fastify/static": "^7.0.4",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "mysql2": "^3.11.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
