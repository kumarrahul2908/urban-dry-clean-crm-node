{
  "name": "urban-dry-clean-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Urban Dry Clean CRM - native Windows desktop app (Electron shell around the existing Node/Fastify backend)",
  "author": "Urban Dry Clean",
  "main": "main.cjs",
  "scripts": {
    "prepare-backend": "node scripts/prepare-backend.cjs",
    "start": "npm run prepare-backend && electron .",
    "dev": "electron .",
    "build:win": "npm run prepare-backend && electron-builder --win",
    "build:win:dir": "npm run prepare-backend && electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "in.urbandryclean.crm",
    "productName": "Urban Dry Clean CRM",
    "copyright": "Urban Dry Clean",
    "publish": null,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "jobs.cjs",
      "setup.html",
      "splash.html",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      { "from": "resources/backend", "to": "backend" }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Urban Dry Clean CRM"
    }
  }
}
